GROQ_API_KEY=your_groq_api_key_here
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Phase 1.5 — Supabase (Auth + Postgres + Storage)
# Populate these in your own .env after creating the Supabase project and
# the Google OAuth application. Never commit real values here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://user:password@your-project-db-host:5432/postgres

# Optional: extra allowed CORS origins, comma-separated, exact origins only
# (scheme://host[:port], no path). Local development ports and the production
# frontend are built in (app/core/cors.py).
# CORS_EXTRA_ORIGINS=https://your-custom-domain.example

# ---------------------------------------------------------------------
# Usage limiting (E1). All server-side only — never sent to a client.
# Every value below is an INITIAL ENGINEERING DEFAULT and is optional:
# the code in app/core/limits.py falls back to these same numbers.
# ---------------------------------------------------------------------

# Kill switch for per-user burst limiting (A) and daily quotas (B).
# Anything other than off/false/0/no leaves enforcement ON, so a typo
# fails safe. Per-paper caps and the indexing slot are NOT disabled by
# this: they protect the provider's shared limit and request duration.
# QUOTA_ENFORCEMENT=on

# AI generations — ask-stream, research, compare-papers, summarize-paper
# AI_RATE_PER_MINUTE=5
# AI_QUOTA_PER_DAY=50

# Indexing runs — index-document
# INDEX_RATE_PER_MINUTE=3
# INDEX_QUOTA_PER_DAY=20

# How long an indexing request waits for the single global indexing slot
# before returning a retryable busy response, in seconds.
# INDEX_SLOT_WAIT_SECONDS=5

# Per-paper cost caps, enforced before any embedding call is made.
# MAX_PAGES_PER_PAPER=40
# MAX_CHUNKS_PER_PAPER=150

# Configured but NOT yet enforced (search, paper-details, upload, and the
# cheap read endpoints are wired in a later phase).
# QUERY_RATE_PER_MINUTE=20
# QUERY_QUOTA_PER_DAY=200
# UPLOAD_RATE_PER_MINUTE=5
# UPLOAD_QUOTA_PER_DAY=10
# READ_RATE_PER_MINUTE=60
