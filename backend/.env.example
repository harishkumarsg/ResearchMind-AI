GROQ_API_KEY=your_groq_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Phase 1.5 — Supabase (Auth + Postgres + Storage)
# Populate these in your own .env after creating the Supabase project and
# the Google OAuth application. Never commit real values here.
#
# API keys: use the NEW keys from Project Settings > API Keys. The legacy
# JWT keys (the anon and service_role values starting with "eyJ") are
# disabled on the production project: any request made with one is rejected.
#   SUPABASE_ANON_KEY          = the publishable key (sb_publishable_...)
#   SUPABASE_SERVICE_ROLE_KEY  = a secret key (sb_secret_...), server-side only
# The variable names are historical and are kept so deployments need no
# rename. The publishable key only identifies the project: uploads still
# run as the signed-in user, whose JWT is what Storage's RLS checks.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here
DATABASE_URL=postgresql://user:password@your-project-db-host:5432/postgres

# Optional: extra allowed CORS origins, comma-separated, exact origins only
# (scheme://host[:port], no path). Local development ports and the production
# frontend are built in (app/core/cors.py).
# CORS_EXTRA_ORIGINS=https://your-custom-domain.example

# ---------------------------------------------------------------------
# Usage limiting (E1). All server-side only — never sent to a client.
# Every value below is an INITIAL ENGINEERING DEFAULT and is optional:
# the code in app/core/limits.py falls back to these same numbers.
# ---------------------------------------------------------------------

# Kill switch for per-user burst limiting (A) and daily quotas (B).
# Anything other than off/false/0/no leaves enforcement ON, so a typo
# fails safe. Per-paper caps and the indexing slot are NOT disabled by
# this: they protect the provider's shared limit and request duration.
# QUOTA_ENFORCEMENT=on

# AI generations — ask-stream, research, compare-papers, summarize-paper
# AI_RATE_PER_MINUTE=5
# AI_QUOTA_PER_DAY=50

# Indexing runs — index-document
# INDEX_RATE_PER_MINUTE=3
# INDEX_QUOTA_PER_DAY=20

# How long an indexing request waits for the single global indexing slot
# before returning a retryable busy response, in seconds.
# INDEX_SLOT_WAIT_SECONDS=5

# Per-paper cost caps, enforced before any embedding call is made.
# MAX_PAGES_PER_PAPER=40
# MAX_CHUNKS_PER_PAPER=150

# Query embeddings — search, paper-details
# QUERY_RATE_PER_MINUTE=20
# QUERY_QUOTA_PER_DAY=200

# Uploads — upload
# UPLOAD_RATE_PER_MINUTE=5
# UPLOAD_QUOTA_PER_DAY=10

# Cheap reads, burst limit only (no daily quota) — export-report,
# latest-report, paper-evidence, and the read paths of paper-intelligence
# and paper-relationship. /papers, /stats and /paper-file are not limited.
# READ_RATE_PER_MINUTE=60

# ---------------------------------------------------------------------
# Provider timeouts (P1). Server-side only, all optional: the code in
# app/core/providers.py falls back to these same defaults.
# ---------------------------------------------------------------------

# Groq read/write/pool timeout and connect timeout, in seconds.
# GROQ_TIMEOUT_SECONDS=30
# GROQ_CONNECT_TIMEOUT_SECONDS=5

# Groq SDK retries. 1 means at most 2 attempts; 0 disables retries.
# Deliberately below the SDK default of 2, to cap latency and repeat billing.
# GROQ_MAX_RETRIES=1

# End-to-end limit on a streamed Ask answer, in seconds.
# GROQ_STREAM_DEADLINE_SECONDS=90

# Voyage request timeout, applied to connect and read separately.
# Voyage SDK retries stay disabled; the existing rate-limit backoff is unchanged.
# VOYAGE_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------
# Voyage embedding batching and rate-limit backoff. All optional: the
# code in app/rag/embedder.py falls back to these same defaults, which
# are tuned for Voyage's free tier (3 requests/min, 10K tokens/min).
# ---------------------------------------------------------------------

# Estimated-token budget per embedding request, and an absolute cap on
# chunks per request as a backstop.
# VOYAGE_MAX_TOKENS_PER_REQUEST=6000
# VOYAGE_MAX_CHUNKS_PER_REQUEST=50

# Minimum spacing between embedding requests, in seconds. Lower it on a
# higher-throughput Voyage account.
# VOYAGE_EMBED_PACING_SECONDS=21

# Retries after a Voyage rate-limit response, with exponential backoff
# between the base and the max, in seconds.
# VOYAGE_MAX_RETRIES=5
# VOYAGE_BACKOFF_BASE_SECONDS=5
# VOYAGE_BACKOFF_MAX_SECONDS=60

# ---------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------

# Rerank retrieved passages with Voyage's rerank API before answering.
# Off unless set to exactly "true" (case-insensitive).
# RERANK_ENABLED=false
