# Public, browser-safe values only — never put a secret or the Supabase
# service_role key here. These ship to the client bundle (Vite's VITE_
# prefix), matching the convention already used for VITE_API_BASE_URL.
#
# Get these from your Supabase project settings > API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Already-existing convention (see src/lib/api.ts) — the deployed backend URL.
VITE_API_BASE_URL=http://localhost:8000
